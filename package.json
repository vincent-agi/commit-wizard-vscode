{
  "name": "commit-wizard-vscode",
  "displayName": "Commit Wizard",
  "description": "An interactive VS Code sidebar extension to effortlessly craft structured Conventional Commits with Gitmojis, dynamic scopes, and automated issue tracking.",
  "version": "0.1.0",
  "publisher": "vincent-agi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmojiCommit",
          "title": "Gitmoji Commit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitmojiCommit": [
        {
          "type": "webview",
          "id": "gitmojiCommit.commitView",
          "name": "Commit Builder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Commit Wizard",
      "properties": {
        "gitmojiCommit.scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "The scope name, e.g. \"webview\"." },
              "description": {
                "type": "string",
                "description": "A short explanation of when to use this scope."
              }
            },
            "required": ["name", "description"]
          },
          "default": [],
          "scope": "window",
          "description": "Project-specific scopes offered in the scope dropdown, each with a short description."
        },
        "gitmojiCommit.titleWarningLength": {
          "type": "number",
          "default": 50,
          "description": "Character count at which the title shows a soft warning."
        },
        "gitmojiCommit.titleMaxLength": {
          "type": "number",
          "default": 72,
          "description": "Character count at which the title shows a hard warning."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "pretest:e2e": "npm run compile",
    "test:e2e": "node ./out/test/runTest.js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
