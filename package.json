{
  "name": "commit-wizard-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "vincent-agi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmojiCommit",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitmojiCommit": [
        {
          "type": "webview",
          "id": "gitmojiCommit.commitView",
          "name": "%view.commitView.name%",
          "icon": "media/icon.svg"
        },
        {
          "id": "gitmojiCommit.history",
          "name": "%view.history.name%",
          "icon": "media/icon.svg",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "gitmojiCommit.release",
          "name": "%view.release.name%",
          "icon": "media/icon.svg",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitmojiCommit.history.refresh",
          "when": "view == gitmojiCommit.history",
          "group": "navigation@1"
        },
        {
          "command": "gitmojiCommit.history.filter",
          "when": "view == gitmojiCommit.history && !gitmojiCommit.historyFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitmojiCommit.history.unfilter",
          "when": "view == gitmojiCommit.history && gitmojiCommit.historyFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitmojiCommit.release.refresh",
          "when": "view == gitmojiCommit.release",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitmojiCommit.history.reword",
          "when": "view == gitmojiCommit.history && viewItem =~ /^commit-(head-)?fixable$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        { "command": "gitmojiCommit.history.show", "when": "false" },
        { "command": "gitmojiCommit.history.reword", "when": "false" },
        { "command": "gitmojiCommit.release.openPr", "when": "false" },
        { "command": "gitmojiCommit.release.signIn", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "gitmojiCommit.focus",
        "key": "ctrl+k ctrl+g",
        "mac": "cmd+k cmd+g"
      }
    ],
    "commands": [
      {
        "command": "gitmojiCommit.focus",
        "title": "%command.focus.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.history.refresh",
        "title": "%command.history.refresh.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitmojiCommit.history.filter",
        "title": "%command.history.filter.title%",
        "category": "%category%",
        "icon": "$(filter)"
      },
      {
        "command": "gitmojiCommit.history.unfilter",
        "title": "%command.history.unfilter.title%",
        "category": "%category%",
        "icon": "$(filter-filled)"
      },
      {
        "command": "gitmojiCommit.history.show",
        "title": "%command.history.show.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.history.reword",
        "title": "%command.history.reword.title%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "gitmojiCommit.release.refresh",
        "title": "%command.release.refresh.title%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "gitmojiCommit.release.signIn",
        "title": "%command.release.signIn.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.release.openPr",
        "title": "%command.release.openPr.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.newBranch",
        "title": "%command.newBranch.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.generatePullRequest",
        "title": "%command.generatePullRequest.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.newIssue",
        "title": "%command.newIssue.title%",
        "category": "%category%"
      },
      {
        "command": "gitmojiCommit.installHooks",
        "title": "%command.installHooks.title%",
        "category": "%category%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".commit-wizard.json",
        "url": "./schemas/commit-wizard.schema.json"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "gitmojiCommit.scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%setting.scopes.items.properties.name.description%"
              },
              "description": {
                "type": "string",
                "description": "%setting.scopes.items.properties.description.description%"
              }
            },
            "required": [
              "name",
              "description"
            ]
          },
          "default": [],
          "scope": "window",
          "description": "%setting.scopes.description%"
        },
        "gitmojiCommit.types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%setting.types.items.properties.name.description%"
              },
              "description": {
                "type": "string",
                "description": "%setting.types.items.properties.description.description%"
              },
              "emoji": {
                "type": "string",
                "description": "%setting.types.items.properties.emoji.description%"
              }
            },
            "required": [
              "name"
            ]
          },
          "default": [],
          "scope": "window",
          "description": "%setting.types.description%"
        },
        "gitmojiCommit.emojis": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "%setting.emojis.description%"
        },
        "gitmojiCommit.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["main", "master"],
          "scope": "window",
          "description": "%setting.protectedBranches.description%"
        },
        "gitmojiCommit.ai.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.ai.enabled.description%"
        },
        "gitmojiCommit.issueTracker.preset": {
          "type": "string",
          "enum": ["", "jira", "linear", "github"],
          "default": "",
          "scope": "window",
          "description": "%setting.issueTracker.preset.description%"
        },
        "gitmojiCommit.issueTracker.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.issueTracker.baseUrl.description%"
        },
        "gitmojiCommit.issueUrlTemplate": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.issueUrlTemplate.description%"
        },
        "gitmojiCommit.branchPattern": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.branchPattern.description%"
        },
        "gitmojiCommit.issuePattern": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "%setting.issuePattern.description%"
        },
        "gitmojiCommit.emojiPosition": {
          "type": "string",
          "enum": ["before", "after"],
          "default": "before",
          "scope": "window",
          "description": "%setting.emojiPosition.description%"
        },
        "gitmojiCommit.history.count": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "scope": "window",
          "description": "%setting.history.count.description%"
        },
        "gitmojiCommit.history.merges": {
          "type": "string",
          "enum": ["ignore", "flag"],
          "default": "ignore",
          "scope": "window",
          "description": "%setting.history.merges.description%"
        },
        "gitmojiCommit.telemetry.endpoint": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "%setting.telemetry.endpoint.markdownDescription%"
        },
        "gitmojiCommit.titleWarningLength": {
          "type": "number",
          "default": 50,
          "description": "%setting.titleWarningLength.description%"
        },
        "gitmojiCommit.titleMaxLength": {
          "type": "number",
          "default": 72,
          "description": "%setting.titleMaxLength.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest:e2e": "npm run compile",
    "test:e2e": "node ./out/test/runTest.js",
    "package": "npm run compile && vsce package --baseContentUrl .",
    "vscode:prepublish": "npm run compile",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "husky": "^9.1.7",
    "mocha": "^10.3.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  }
}
