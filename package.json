{
  "name": "commit-wizard-vscode",
  "displayName": "Commit Wizard",
  "description": "An interactive VS Code sidebar extension to effortlessly craft structured Conventional Commits with Gitmojis, dynamic scopes, and automated issue tracking.",
  "version": "0.1.0",
  "publisher": "vincent-agi",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitmojiCommit",
          "title": "Gitmoji Commit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitmojiCommit": [
        {
          "type": "webview",
          "id": "gitmojiCommit.commitView",
          "name": "Commit Builder",
          "icon": "media/icon.svg"
        },
        {
          "id": "gitmojiCommit.history",
          "name": "Commit History",
          "icon": "media/icon.svg",
          "when": "workspaceFolderCount > 0"
        },
        {
          "id": "gitmojiCommit.release",
          "name": "Release Preview",
          "icon": "media/icon.svg",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitmojiCommit.history.refresh",
          "when": "view == gitmojiCommit.history",
          "group": "navigation@1"
        },
        {
          "command": "gitmojiCommit.history.filter",
          "when": "view == gitmojiCommit.history && !gitmojiCommit.historyFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitmojiCommit.history.unfilter",
          "when": "view == gitmojiCommit.history && gitmojiCommit.historyFiltered",
          "group": "navigation@2"
        },
        {
          "command": "gitmojiCommit.release.refresh",
          "when": "view == gitmojiCommit.release",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitmojiCommit.history.reword",
          "when": "view == gitmojiCommit.history && viewItem =~ /^commit-(head-)?fixable$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        { "command": "gitmojiCommit.history.show", "when": "false" },
        { "command": "gitmojiCommit.history.reword", "when": "false" },
        { "command": "gitmojiCommit.release.openPr", "when": "false" },
        { "command": "gitmojiCommit.release.signIn", "when": "false" }
      ]
    },
    "keybindings": [
      {
        "command": "gitmojiCommit.focus",
        "key": "ctrl+k ctrl+g",
        "mac": "cmd+k cmd+g"
      }
    ],
    "commands": [
      {
        "command": "gitmojiCommit.focus",
        "title": "Focus the Commit Builder",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.history.refresh",
        "title": "Refresh Commit History",
        "category": "Commit Wizard",
        "icon": "$(refresh)"
      },
      {
        "command": "gitmojiCommit.history.filter",
        "title": "Show Only Non-Conforming Commits",
        "category": "Commit Wizard",
        "icon": "$(filter)"
      },
      {
        "command": "gitmojiCommit.history.unfilter",
        "title": "Show All Commits",
        "category": "Commit Wizard",
        "icon": "$(filter-filled)"
      },
      {
        "command": "gitmojiCommit.history.show",
        "title": "Show Commit Details",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.history.reword",
        "title": "Reword This Commit",
        "category": "Commit Wizard",
        "icon": "$(edit)"
      },
      {
        "command": "gitmojiCommit.release.refresh",
        "title": "Refresh Release Preview",
        "category": "Commit Wizard",
        "icon": "$(refresh)"
      },
      {
        "command": "gitmojiCommit.release.signIn",
        "title": "Sign In to See the Release Pull Request",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.release.openPr",
        "title": "Open the Release Pull Request",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.newBranch",
        "title": "New Branch from Type and Ticket",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.generatePullRequest",
        "title": "Generate Pull Request Description",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.newIssue",
        "title": "New Issue or Milestone (GitHub)",
        "category": "Commit Wizard"
      },
      {
        "command": "gitmojiCommit.installHooks",
        "title": "Install Git Hooks (husky / lefthook)",
        "category": "Commit Wizard"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".commit-wizard.json",
        "url": "./schemas/commit-wizard.schema.json"
      }
    ],
    "configuration": {
      "title": "Commit Wizard",
      "properties": {
        "gitmojiCommit.scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The scope name, e.g. \"webview\"."
              },
              "description": {
                "type": "string",
                "description": "A short explanation of when to use this scope."
              }
            },
            "required": [
              "name",
              "description"
            ]
          },
          "default": [],
          "scope": "window",
          "description": "Project-specific scopes offered in the scope dropdown, each with a short description."
        },
        "gitmojiCommit.types": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The type keyword, e.g. \"deps\"."
              },
              "description": {
                "type": "string",
                "description": "Short explanation shown in the dropdown."
              },
              "emoji": {
                "type": "string",
                "description": "Gitmoji preselected when this type is picked."
              }
            },
            "required": [
              "name"
            ]
          },
          "default": [],
          "scope": "window",
          "description": "Commit types offered in the Type dropdown. Empty uses the built-in ten types. Overridden by .commit-wizard.json."
        },
        "gitmojiCommit.emojis": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Prefix commit messages with a Gitmoji. When disabled, the Gitmoji dropdown is hidden. Overridden by .commit-wizard.json."
        },
        "gitmojiCommit.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["main", "master"],
          "scope": "window",
          "description": "Branch names or globs on which committing asks for confirmation. Overridden by .commit-wizard.json."
        },
        "gitmojiCommit.ai.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Offer a \"Draft with AI\" button that sends the staged diff (after you confirm) to a language model you choose in VS Code. Off by default; this setting is never read from .commit-wizard.json."
        },
        "gitmojiCommit.issueTracker.preset": {
          "type": "string",
          "enum": ["", "jira", "linear", "github"],
          "default": "",
          "scope": "window",
          "description": "Issue tracker preset: detects ticket keys in branch names and links them. Overridden by .commit-wizard.json."
        },
        "gitmojiCommit.issueTracker.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Root URL of the tracker (e.g. https://example.atlassian.net), needed to link Jira and Linear tickets."
        },
        "gitmojiCommit.issueUrlTemplate": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "URL linking a reference to its ticket, with an {id} placeholder. Overrides the tracker preset."
        },
        "gitmojiCommit.branchPattern": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Pattern of the New Branch command ({type}, {issue}, {slug}). Empty uses {type}/{issue}-{slug}."
        },
        "gitmojiCommit.issuePattern": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Regular expression used to detect the issue in the branch name (first capture group, or the whole match). Empty uses the built-in detection."
        },
        "gitmojiCommit.emojiPosition": {
          "type": "string",
          "enum": ["before", "after"],
          "default": "before",
          "scope": "window",
          "description": "Where the Gitmoji goes in the header: before the type (\"✨ feat: x\") or after the colon (\"feat: ✨ x\"). Use \"after\" with Release Please, which only reads headers that start with the type. Overridden by .commit-wizard.json."
        },
        "gitmojiCommit.history.count": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "scope": "window",
          "description": "Number of latest commits shown in the Commit History view."
        },
        "gitmojiCommit.history.merges": {
          "type": "string",
          "enum": ["ignore", "flag"],
          "default": "ignore",
          "scope": "window",
          "description": "Merge commits in the Commit History view: ignore them, or list them with a merge icon."
        },
        "gitmojiCommit.telemetry.endpoint": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "HTTPS URL receiving anonymous usage events as JSON. Empty (default): events are only written to the *Commit Wizard Telemetry* output channel and nothing is sent. Nothing is reported at all when VS Code telemetry is turned off (`telemetry.telemetryLevel`)."
        },
        "gitmojiCommit.titleWarningLength": {
          "type": "number",
          "default": 50,
          "description": "Character count at which the title shows a soft warning."
        },
        "gitmojiCommit.titleMaxLength": {
          "type": "number",
          "default": 72,
          "description": "Character count at which the title shows a hard warning."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "pretest:e2e": "npm run compile",
    "test:e2e": "node ./out/test/runTest.js",
    "package": "vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run compile",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "husky": "^9.1.7",
    "mocha": "^10.3.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  }
}
